# Copy to apps/mobile/.env and fill in. Use the SAME Supabase project as
# apps/web/.env so accounts are shared.
#
# Expo inlines every EXPO_PUBLIC_ var into the shipped app bundle, where anyone
# can read it out of the binary. Nothing secret belongs in this file — that is
# why there is no TMDB token here: reads go through the web app's proxy, which
# holds the token server-side.

# TMDB proxy — the web app's /api/tmdb route. Must be http:// when pointing at
# `next dev`, which serves no TLS; an https:// URL there simply times out.
#
#   iOS simulator / Android emulator on the same Mac:
#     http://localhost:3000/api/tmdb   (the simulator shares the host network)
#   Physical device on the same Wi-Fi — localhost would mean the phone itself,
#   so use the Mac's LAN address as printed by `next dev`:
#     http://192.168.1.20:3000/api/tmdb
#   Deployed:
#     https://YOUR_WEB_APP_DOMAIN/api/tmdb
EXPO_PUBLIC_TMDB_PROXY_URL="http://localhost:3000/api/tmdb"
EXPO_PUBLIC_TMDB_IMAGE_PATH="https://image.tmdb.org/t/p/"

# Supabase — https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
